{
  "name": "copilotkit-langgraph-example",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:ui\" \"npm run dev:agent\" --names ui,agent --prefix-colors blue,green --kill-others",
    "dev:debug": "LOG_LEVEL=debug npm run dev",
    "dev:agent": "sh ./scripts/run-backend.sh || sh ./scripts/run-backend.bat",
    "dev:ui": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "install:agent": "sh ./scripts/setup-backend.sh || sh ./scripts/setup-backend.bat",
    "postinstall": "npm run install:agent"
  },
  "dependencies": {
    "@copilotkit/react-core": "1.79.1",
    "@copilotkit/runtime": "1.79.1",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@langchain/langgraph-cli": "^1.5.4",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.6",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "@ag-ui/client": "1.0.2",
    "@ag-ui/core": "1.0.2",
    "@ag-ui/encoder": "1.0.2",
    "@ag-ui/proto": "1.0.2"
  },
  "pnpm": {
    "overrides": {
      "@ag-ui/client": "1.0.2",
      "@ag-ui/core": "1.0.2",
      "@ag-ui/encoder": "1.0.2",
      "@ag-ui/proto": "1.0.2"
    }
  }
}
